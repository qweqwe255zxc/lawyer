  const now = new Date();

  return [
    {
      url: siteConfig.seo.siteUrl,
      lastModified: now,
      changeFrequency: "monthly",
      priority: 1,
    },
    ...siteConfig.footer.links.map((link) => ({
      url: `${siteConfig.seo.siteUrl}${link.href}`,
