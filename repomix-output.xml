<file path="app/globals.css">
@import "tailwindcss";
@import "../theme/tokens.css";

/* ============================================================================
   Маппинг Tailwind на CSS-переменные.
   Все значения приходят из theme/tokens.css — здесь только имена утилит.
   `inline` обязателен: иначе рантайм-переопределения [data-surface] и
   [data-theme] не долетят до утилит.
   ========================================================================= */
@theme inline {
  /* Контекстные цвета — меняются вместе с data-surface секции */
  --color-bg: var(--surface-bg);
  --color-fg: var(--surface-fg);
  --color-fg-muted: var(--surface-fg-muted);
  --color-rule: var(--surface-rule);
  --color-rule-strong: var(--surface-rule-strong);

  /* Заливка карточек: bg-card. Обычно совпадает с bg-bg своей секции —
     см. --surface-card в tokens.css. */
  --color-card: var(--surface-card);

  /* Абсолютные цвета палитры — когда нужен именно этот тон */
  --color-paper: var(--palette-paper);
  --color-surface: var(--palette-surface);
  --color-ink: var(--palette-ink);
  --color-ink-muted: var(--palette-ink-muted);

  /* Акцент */
  --color-accent: var(--accent);
  --color-accent-border: var(--accent-border);
  --color-badge-soft: var(--badge-soft-bg);
  --color-badge-soft-fg: var(--badge-soft-fg);
  --color-accent-hover: var(--accent-hover);
  --color-accent-active: var(--accent-active);
  --color-accent-fg: var(--accent-fg);
  --color-btn-primary: var(--btn-primary-bg);
  --color-btn-primary-fg: var(--btn-primary-fg);
  --color-btn-primary-hover: var(--btn-primary-bg-hover);
  --color-btn-primary-active: var(--btn-primary-bg-active);

  /* Шрифты */
  --font-display: var(--font-display-stack);
  --font-body: var(--font-body-stack);
  --font-heading: var(--font-heading-stack);
  --font-mono: var(--font-mono-stack);

  /* Типографическая шкала (размер + интерлиньяж + трекинг одним классом) */
  --text-h1: var(--size-h1);
  --text-h1--line-height: var(--leading-h1);
  --text-h1--letter-spacing: var(--tracking-h1);

  --text-h2: var(--size-h2);
  --text-h2--line-height: var(--leading-h2);
  --text-h2--letter-spacing: var(--tracking-h2);

  --text-h3: var(--size-h3);
  --text-h3--line-height: var(--leading-h3);
  --text-h3--letter-spacing: var(--tracking-h3);

  --text-stat: var(--size-stat);
  --text-stat--line-height: var(--leading-stat);
  --text-stat--letter-spacing: var(--tracking-h1);

  --text-quote: var(--size-quote);
  --text-quote--line-height: var(--leading-quote);
  --text-quote--letter-spacing: var(--tracking-h3);

  --text-lead: var(--size-lead);
  --text-lead--line-height: 1.5;

  --text-body: var(--size-body);
  --text-body--line-height: var(--leading-body);

  --text-small: var(--size-small);
  --text-small--line-height: 1.5;

  --text-caption: var(--size-caption);
  --text-caption--line-height: var(--leading-tight);
  --text-caption--letter-spacing: var(--tracking-caption);

  --text-button: var(--size-button);
  --text-button--line-height: var(--leading-flat);
  --text-button--letter-spacing: var(--tracking-button);

  /* Ритм */
  --spacing-section: var(--space-section);
  --spacing-section-lg: var(--space-section-lg);
  --spacing-section-sm: var(--space-section-sm);
  --spacing-gutter: var(--layout-gutter);
  --spacing-header: var(--header-height);

  --container-page: var(--layout-container);
  --container-narrow: var(--layout-narrow);

  /* Радиусы. --radius-sm/md (2/4px) остаются документными и приезжают
     сюда под именами rounded-doc-sm / rounded-doc — так исторически
     свёрстана база. Расширенная шкала (lg/xl/2xl) перекрывает
     одноимённые значения Tailwind по умолчанию, чтобы «12/16/24» были
     одни и те же и в утилитах, и в токенах.
     Самоссылка вида `--radius-lg: var(--radius-lg)` — не опечатка:
     при `@theme inline` переменная не эмитится в :root, а подставляется
     в утилиту как есть, и значение приходит из tokens.css (тот же
     приём, что у --ease-ui ниже).
     rounded-card / rounded-control / rounded-pill — не ступени шкалы,
     а РОЛИ: какую ступень они означают, решает пресет тарифа
     (см. блок ПРЕСЕТЫ в tokens.css). Радиус медиа применяет класс
     .ui-media ниже, отдельная утилита ему не нужна. */
  --radius-doc: var(--radius-md);
  --radius-doc-sm: var(--radius-sm);
  --radius-card: var(--radius-card);
  --radius-control: var(--radius-control);
  --radius-pill: var(--radius-pill);
  --radius-lg: var(--radius-lg);
  --radius-xl: var(--radius-xl);
  --radius-2xl: var(--radius-2xl);

  /* Глубина: shadow-none/sm/md/lg + shadow-card-hover под подъём
     карточки на hover. Значения — --elevation-* из tokens.css,
     включая усиленные для тёмной темы и для пресета «Стандарт». */
  --shadow-none: var(--elevation-none);
  --shadow-sm: var(--elevation-sm);
  --shadow-md: var(--elevation-md);
  --shadow-lg: var(--elevation-lg);
  --shadow-card-hover: var(--elevation-card-hover);

  --ease-reveal: var(--ease-reveal);
  --ease-ui: var(--ease-ui);
}

/* ========================================================================= */

@layer base {
  *,
  *::before,
  *::after {
    border-color: var(--surface-rule);
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    background-color: var(--palette-paper);
    color: var(--palette-ink);
    font-family: var(--font-body-stack);
    font-size: var(--size-body);
    line-height: var(--leading-body);
    font-weight: var(--weight-regular);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3,
  h4,
  blockquote {
    font-family: var(--font-display-stack);
    font-weight: var(--weight-regular);
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  /* Единственное место, где живёт focus-ring — и он всегда акцентный */
  :focus-visible {
    outline: var(--border-accent-marker) solid var(--accent-ring);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  ::selection {
    background-color: var(--accent);
    color: var(--accent-fg);
  }

  /* Якорные ссылки не прячутся под sticky-хедер */
  :target,
  [data-section] {
    scroll-margin-top: var(--scroll-offset);
  }

  img,
  svg,
  video {
    display: block;
    max-width: 100%;
    height: auto;
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
    color: inherit;
  }
}

/* ============================================================================
   СЛОЙ ГЛУБИНЫ — классы, читающие ручки пресета из theme/tokens.css.

   Зачем классы, а не утилиты Tailwind прямо в компонентах: значения
   этих свойств зависят и от поверхности секции (--surface-*), и от
   тарифа (--card-*, --icon-tile-*, --control-*), а их комбинация не
   выражается набором статических утилит. Компонент вешает одну роль
   («это карточка», «это поле», «это медиа-бокс»), а чем она окажется —
   плоской рамкой Эконома или поднятой карточкой Стандарта — решают
   токены. В @layer components специально: обычные утилиты Tailwind
   (border-fg у выделенного тарифа, h-full, mt-*) должны такой класс
   перебивать, а слой utilities идёт после components.

   Базовые значения токенов — экономовские, поэтому все правила ниже
   в базе дают ровно то же, что было захардкожено раньше: тень none,
   подъём 0, документные радиусы, паддинг плашки 0.
   ========================================================================= */
@layer components {
  /* ---- Карточка ---------------------------------------------------- */
  .ui-card {
    background-color: var(--card-bg);
    border-color: var(--card-border);
    border-radius: var(--radius-card);
    box-shadow: var(--card-shadow);
    transition:
      box-shadow var(--duration-ui) var(--ease-ui),
      transform var(--duration-ui) var(--ease-ui),
      border-color var(--duration-ui) var(--ease-ui);
  }

  .ui-card:hover {
    box-shadow: var(--card-shadow-hover);
  }

  /* Сдвиг — только под motion-safe, тень плавно меняется всегда:
     при prefers-reduced-motion карточка не должна прыгать. */
  @media (prefers-reduced-motion: no-preference) {
    .ui-card:hover {
      transform: translateY(var(--card-lift));
    }
  }

  /* Явно поднятая карточка: собственная поверхность и своя пара теней,
     не зависящая от того, плоский ли пресет. */
  .ui-card--elevated {
    --card-bg: var(--card-elevated-bg);
    --card-border: var(--card-elevated-border);
    --card-shadow: var(--card-elevated-shadow);
    --card-shadow-hover: var(--card-elevated-shadow-hover);
  }

  /* Глубина рамкой вместо тени. */
  .ui-card--accent {
    --card-bg: var(--surface-card);
    --card-border: var(--accent-border);
    --card-shadow: var(--elevation-none);
    --card-shadow-hover: var(--elevation-none);
  }

  /* Выделенный тариф в Pricing. Объявлен после вариантов выше, чтобы
     перебить их рамку: у правил одинаковая специфичность, побеждает
     последнее. Тот же токен применяет .ui-featured-border в табличной
     раскладке, где карточки нет вообще. */
  .ui-card--featured,
  .ui-featured-border {
    border-color: var(--card-featured-border);
  }

  .ui-card--featured {
    --card-border: var(--card-featured-border);
    --card-shadow: var(--card-featured-shadow);
    --card-shadow-hover: var(--card-featured-shadow);
  }

  /* «Живая, но не кликабельная»: реагирует на курсор тенью, но без
     cursor-pointer — карточка никуда не ведёт, и указатель обещал бы
     клик, которого нет (таймлайн шагов). Значение — ступень шкалы, а
     не число: в «Экономе» это прежний shadow-lg, в «Стандарте» та же
     ступень уже двухслойная. */
  .ui-card--live {
    --card-shadow-hover: var(--elevation-lg);
  }

  /* Кликабельная карточка. Объявлена ПОСЛЕ вариантов выше: у правил
     одинаковая специфичность, и побеждает последнее — значит подъём
     интерактивной карточки перебивает покой любого варианта. */
  .ui-card--interactive {
    --card-shadow-hover: var(--card-hover-shadow);
    --card-lift: var(--card-hover-lift);
  }

  /* ---- Кнопка -------------------------------------------------------- */
  /* Раньше тут был rounded-doc-sm + transition-colors прямо в компоненте.
     Теперь и радиус, и глубина — ручки пресета; в базе они дают ровно
     ту же плоскую кнопку (2px, тень none, сдвиг 0). */
  .ui-button {
    border-radius: var(--radius-control);
    box-shadow: var(--btn-shadow);
    transition:
      color var(--duration-ui) var(--ease-ui),
      background-color var(--duration-ui) var(--ease-ui),
      border-color var(--duration-ui) var(--ease-ui),
      box-shadow var(--duration-ui) var(--ease-ui),
      transform var(--duration-ui) var(--ease-ui);
  }

  .ui-button:hover {
    box-shadow: var(--btn-shadow-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ui-button:hover {
      transform: translateY(var(--btn-lift));
    }
  }

  /* ---- Плашка под иконкой ------------------------------------------ */
  /* В Экономе паддинг 0 и прозрачный фон — визуально это голая иконка
     ровно на том же месте, что и раньше (высота = высота svg). */
  .icon-tile {
    display: flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    padding: var(--icon-tile-padding);
    border-radius: var(--icon-tile-radius);
    background-color: var(--icon-tile-bg);
    color: var(--icon-tile-fg);
  }

  /* ---- Медиа-бокс (фото, карта, аватар) ---------------------------- */
  /* Только скругление — для фото ВНУТРИ карточки: своя тень у картинки
     поверх тени карточки даёт грязный двойной ореол. */
  .ui-media {
    border-radius: var(--radius-media);
  }

  /* Скругление + тень — для самостоятельного медиа, которое само себе
     объект на странице: фото hero, фото «о нас», карта в контактах. */
  .ui-media-raised {
    border-radius: var(--radius-media);
    box-shadow: var(--media-shadow);
  }

  /* ---- Всплывающая панель (тост, меню селекта) ---------------------- */
  .ui-popover {
    border-radius: var(--popover-radius);
    box-shadow: var(--popover-shadow);
  }

  /* ---- Поле формы --------------------------------------------------- */
  /* База: подчёркивание (border только снизу, без фона и радиуса).
     Стандарт: коробка. Цвет линии на hover/focus остаётся утилитами
     в компоненте — они из слоя utilities и перебивают этот класс. */
  .ui-control {
    background-color: var(--control-bg);
    border-style: solid;
    border-width: var(--control-border-width);
    border-color: var(--control-border-color);
    border-radius: var(--control-radius);
    padding: var(--control-pt) var(--control-px) var(--control-pb);
    transition: border-color var(--duration-ui) var(--ease-ui);
  }

  /* ---- Аккордеон ---------------------------------------------------- */
  /* База: список на линейках (gap 0, фона нет) — flex-column с нулевым
     зазором раскладывается идентично прежнему блочному потоку. */
  .ui-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--accordion-gap);
    border-top: var(--border-hairline) solid var(--accordion-top-border);
  }

  .ui-accordion-item {
    border-bottom: var(--border-hairline) solid var(--accordion-border);
    border-radius: var(--accordion-radius);
    background-color: var(--accordion-bg);
    box-shadow: var(--accordion-shadow);
    padding-inline: var(--accordion-px);
  }

  /* ---- Хедер -------------------------------------------------------- */
  .ui-header {
    background-color: var(--header-bg);
    backdrop-filter: var(--header-blur);
    -webkit-backdrop-filter: var(--header-blur);
    transition:
      background-color var(--duration-ui) var(--ease-ui),
      border-color var(--duration-ui) var(--ease-ui),
      box-shadow var(--duration-ui) var(--ease-ui);
  }

  .ui-header[data-scrolled="true"] {
    box-shadow: var(--header-shadow);
  }

  /* ---- Подсветка секции --------------------------------------------- */
  /* background-image поверх background-color самой секции. В базе
     --section-tint: none, поэтому у Эконома фон остаётся заливкой. */
  [data-section] {
    background-image: var(--section-tint);
  }

  /* Hero — своя, более выраженная подсветка. Правило идёт после
     общего: специфичность та же, побеждает последнее. */
  [data-section][data-tint="hero"] {
    background-image: var(--hero-tint);
  }
}

@layer utilities {
  /* Табличные цифры: статистика, телефоны, реестр кейсов */
  .tabular {
    font-variant-numeric: tabular-nums lining-nums;
  }

  .measure {
    max-width: var(--measure-text);
  }

  /* Курсив разрешён ровно в одном случае — отсылки к нормам права */
  .legal-ref {
    font-family: var(--font-display-stack);
    font-style: italic;
  }
}

/* ============================================================================
   REVEAL при скролле — IntersectionObserver, без библиотек.
   Прячем элементы только если рантайм подтвердил поддержку: без JS
   и при prefers-reduced-motion контент виден сразу.
   ========================================================================= */
[data-reveal-enabled="true"] [data-reveal] {
  opacity: 0;
  transform: translateY(var(--reveal-shift));
  transition:
    opacity var(--duration-reveal) var(--ease-reveal),
    transform var(--duration-reveal) var(--ease-reveal);
  transition-delay: var(--reveal-delay, 0ms);
  will-change: opacity, transform;
}

[data-reveal-enabled="true"] [data-reveal][data-revealed="true"] {
  opacity: 1;
  transform: none;
  will-change: auto;
}

@media (prefers-reduced-motion: reduce) {
  [data-reveal-enabled="true"] [data-reveal] {
    opacity: 1;
    transform: none;
    transition: none;
  }
}

/* ============================================================================
   Аккордеон FAQ: высота панели анимируется через grid-template-rows,
   а не через height/max-height — не требует измерения scrollHeight в JS
   и работает для контента любой длины.
   ========================================================================= */
.accordion-panel {
  transition: grid-template-rows var(--duration-reveal) var(--ease-reveal);
}

@media (prefers-reduced-motion: reduce) {
  .accordion-panel {
    transition: none;
  }
}

/* ============================================================================
   Мобильное меню в хедере: та же техника grid-template-rows, что у
   аккордеона (высота ужимается до 0 без display/hidden), плюс лёгкое
   затухание — резкое появление крупной панели выглядит рвано.
   ========================================================================= */
.mobile-nav {
  display: grid;
  grid-template-rows: 0fr;
  opacity: 0;
  transition:
    grid-template-rows var(--duration-reveal) var(--ease-reveal),
    opacity var(--duration-ui) var(--ease-ui);
}

.mobile-nav[data-open="true"] {
  grid-template-rows: 1fr;
  opacity: 1;
}

@media (prefers-reduced-motion: reduce) {
  .mobile-nav {
    transition: none;
  }
}

/* ============================================================================
   Тост: на мобильном — снекбар на всю ширину, въезжает снизу; от sm и шире —
   карточка в правом нижнем углу, въезжает справа. Уходит тем же путём при
   закрытии. Контент остаётся в DOM на время exit-анимации (см. Toast.tsx) —
   иначе закрытие выглядело бы как мгновенное исчезновение.
   ========================================================================= */
.toast {
  opacity: 0;
  transform: translateY(var(--reveal-shift));
  transition:
    opacity var(--duration-toast-exit) var(--ease-ui),
    transform var(--duration-toast-exit) var(--ease-ui);
}

@media (min-width: 640px) {
  .toast {
    transform: translateX(calc(var(--reveal-shift) * 2));
  }
}

.toast[data-state="visible"] {
  opacity: 1;
  transform: none;
  transition-duration: var(--duration-toast-enter);
}

@media (prefers-reduced-motion: reduce) {
  .toast {
    transition: none;
  }
}
