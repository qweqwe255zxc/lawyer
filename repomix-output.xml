<file path="theme/tokens.css">
/* ============================================================================
   TOKENS — единственный источник визуальных значений во всём проекте.
   Правило: ни один компонент не содержит hex, px-размера шрифта, тени
   или радиуса. Всё берётся отсюда через Tailwind-классы или var().
   ========================================================================= */

:root {
  color-scheme: light;

  /* --------------------------------------------------------------------
     1. ПАЛИТРА — ядро (6 токенов)
     -------------------------------------------------------------------- */
  --palette-paper: #f7f5f0; /* фон страницы — тёплая небелёная бумага      */
  --palette-surface: #ffffff; /* поверхность — чистый лист поверх бумаги    */
  --palette-ink: #1a1a18; /* текст + фон единственного тёмного блока      */
  --palette-ink-muted: #55584f; /* вторичный текст, подписи, ВСЕ иконки    */
  --palette-rule: #ddd9d0; /* hairline: линейки, границы сетки            */
  --palette-accent: #14452f; /* хвойный — только 6 мест из правила акцента */

  /* 2. Производные состояния (посчитаны один раз, не color-mix в рантайме) */
  --palette-accent-hover: #103625;
  --palette-accent-active: #0c2a1d;
  --palette-rule-strong: #83867c; /* границы ИНТЕРАКТИВНЫХ элементов, 3.4:1 */

  /* 3. Инверсия для тёмного блока «Кейсы» */
  --palette-ink-fg: #f7f5f0;
  --palette-ink-fg-muted: #9a9c92;
  --palette-ink-rule: #33362f;

  /* --------------------------------------------------------------------
     СЕМАНТИЧЕСКИЙ СЛОЙ — то, чем пользуются компоненты.
     Переопределяется контекстом секции через [data-surface].
     -------------------------------------------------------------------- */
  --surface-bg: var(--palette-paper);
  --surface-fg: var(--palette-ink);
  --surface-fg-muted: var(--palette-ink-muted);
  --surface-rule: var(--palette-rule);
  --surface-rule-strong: var(--palette-rule-strong);
  /* Заливка карточек (bg-card). По умолчанию — цвет самой секции, то
     есть карточка не отличается от фона и «поднимается» только рамкой
     или тенью: так база (Эконом) остаётся плоской. Пресет «Стандарт»
     переопределяет это значение (обычно на var(--palette-surface)),
     и все карточки разом получают собственную поверхность.
     Объявляется заново в каждом [data-surface] ниже — var() внутри
     :root посчитался бы один раз по paper и дальше только наследовался. */
  --surface-card: var(--surface-bg);

  /* Акцент — семантические имена, чтобы правило акцента читалось в коде */
  --accent: var(--palette-accent);
  --accent-hover: var(--palette-accent-hover);
  --accent-active: var(--palette-accent-active);
  --accent-fg: var(--palette-paper); /* текст на акцентной заливке */
  --accent-ring: var(--palette-accent); /* focus-ring, п.4 правила акцента */
  /* Граница карточки Card variant="bordered-accent" и Stats
     containerVariant="bordered". Отдельный токен, а не var(--accent)
     в компоненте: пресет может сделать её мягче (например
     color-mix(in srgb, var(--accent) 40%, transparent)), не трогая
     сам акцент и не переписывая компоненты. */
  --accent-border: var(--accent);

  /* Мягкая плашка Badge variant="soft" (статусы в реестре, бейдж
     виджета в hero). На светлых поверхностях это акцент на 10%-подложке;
     на тёмном и акцентном блоке пара переопределяется в своём
     [data-surface] — хвойный акцент на графите не читается. */
  --badge-soft-bg: color-mix(in srgb, var(--accent) 10%, transparent);
  --badge-soft-fg: var(--accent);

  /* Primary-кнопка. Единственное место, где акцент становится заливкой
     помимо CTA-блока. Внутри акцентного блока пара инвертируется —
     см. [data-surface="accent"] ниже. */
  --btn-primary-bg: var(--palette-accent);
  --btn-primary-fg: var(--palette-paper);
  --btn-primary-bg-hover: var(--palette-accent-hover);
  --btn-primary-bg-active: var(--palette-accent-active);

  /* --------------------------------------------------------------------
     ТИПОГРАФИКА
     -------------------------------------------------------------------- */
  --font-display-stack: var(--font-source-serif), "PT Serif", Georgia,
    "Times New Roman", serif;
  --font-body-stack: var(--font-golos), -apple-system, BlinkMacSystemFont,
    "Segoe UI", Roboto, Arial, sans-serif;
  /* Вторая серифная гарнитура — только для h1/h2 (font-heading), акцентная
     декоративная типографика поверх основного font-display. */
  --font-heading-stack: var(--font-playfair), "PT Serif", Georgia, serif;
  /* Моноширинная — только служебные подписи: теги реестра, коды, номера
     (Badge variant="outline"). Отдельный веб-шрифт под это не тянем,
     системного стека достаточно. */
  --font-mono-stack: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas,
    "Liberation Mono", monospace;

  /* Флюид 375 → 1440px, дальше кегль не растёт (контейнер 1240) */
  /* Нижняя граница 34px, а не 40: на 375px при 40px строка «и жилищные дела»
     не помещается и «дела» отваливается в отдельную строку. */
  --size-h1: clamp(2.125rem, 0.76rem + 5.82vw, 6rem); /* 34 → 96 */
  --size-h2: clamp(1.75rem, 1.4rem + 1.5vw, 2.75rem); /* 28 → 44 */
  --size-h3: clamp(1.25rem, 1.16rem + 0.38vw, 1.5rem); /* 20 → 24 */
  --size-stat: clamp(2.75rem, 2.4rem + 1.5vw, 3.75rem); /* 44 → 60 */
  --size-quote: clamp(1.25rem, 1.07rem + 0.75vw, 1.75rem); /* 20 → 28 */
  --size-lead: clamp(1.125rem, 1.03rem + 0.38vw, 1.375rem); /* 18 → 22 */
  --size-body: clamp(1rem, 0.978rem + 0.094vw, 1.0625rem); /* 16 → 17 */
  --size-small: 0.875rem; /* 14 */
  --size-caption: 0.8125rem; /* 13 */
  --size-button: 0.9375rem; /* 15 */

  --leading-h1: 1.05;
  --leading-h2: 1.12;
  --leading-h3: 1.3;
  --leading-stat: 1;
  --leading-quote: 1.35;
  --leading-body: 1.6;
  --leading-tight: 1.2;
  --leading-flat: 1;

  --tracking-h1: -0.02em;
  --tracking-h2: -0.015em;
  --tracking-h3: -0.01em;
  --tracking-normal: 0em;
  --tracking-caption: 0.08em;
  --tracking-button: 0.01em;

  --weight-regular: 400;
  --weight-medium: 500;
  --weight-semibold: 600;

  --measure-text: 68ch; /* максимальная длина строки в текстовых блоках */

  /* --------------------------------------------------------------------
     РИТМ И РАЗМЕРЫ
     -------------------------------------------------------------------- */
  --layout-container: 77.5rem; /* 1240px */
  --layout-narrow: 47.5rem; /* 760px — колонка FAQ */
  --layout-gutter: clamp(1.25rem, 0.9rem + 1.5vw, 2.5rem); /* 20 → 40 */

  --space-section: clamp(4rem, 2.5rem + 6.4vw, 8rem); /* 64 → 128 */
  --space-section-lg: clamp(5rem, 2.8rem + 9.4vw, 10rem); /* 80 → 160 — hero, CTA */
  --space-section-sm: clamp(2.5rem, 2rem + 2.1vw, 3.5rem); /* 40 → 56 — полоса статистики */

  --header-height: 4.5rem; /* 72px */
  --scroll-offset: 6rem; /* header + воздух, для scroll-margin-top */

  /* --------------------------------------------------------------------
     ГРАНИЦЫ, РАДИУСЫ, ТЕНИ

     Всё, что ниже, — это значения тарифа «Эконом»: плоско, документно,
     без теней. Тариф переключается ОДНИМ полем конфига
     (theme.preset в content/site.config.ts → data-preset на <html>),
     а не правкой компонентов: блоки [data-preset="standard"] и
     [data-preset="premium"] в конце файла переопределяют ручки ниже,
     и вся страница разом получает глубину. Ни один компонент про
     пресет не знает.
     -------------------------------------------------------------------- */
  --border-hairline: 1px;
  --border-accent-marker: 2px;

  /* --radius-sm/md намеренно оставлены 2/4px, хотя расширенная шкала
     обычно начинается с 4/8px: на этих двух значениях свёрстана вся
     текущая база (rounded-doc / rounded-doc-sm — кнопки, тосты, боксы
     фото), и их сдвиг переверстал бы Эконом. Шкала поэтому растёт
     вверх, а роли ниже выбирают ступень. */
  --radius-sm: 0.125rem; /* 2px */
  --radius-md: 0.25rem; /* 4px — «документный» радиус базы */
  --radius-lg: 0.75rem; /* 12px */
  --radius-xl: 1rem; /* 16px */
  --radius-2xl: 1.5rem; /* 24px */
  --radius-full: 9999px;

  /* Радиусы по РОЛЯМ, а не по размеру — это и есть ручки пресета.
     Компоненты знают только rounded-card / rounded-control /
     rounded-media / rounded-pill и не содержат конкретных px.
     В базе все четыре — документные, поэтому появление этих имён
     ничего не изменило в Экономе. */
  --radius-card: var(--radius-md); /* карточки, панели, блок статистики */
  --radius-control: var(--radius-sm); /* кнопки, поля, селект */
  --radius-media: var(--radius-sm); /* боксы фото, карта, аватары */
  --radius-pill: var(--radius-sm); /* бейджи, полосы прогресса */

  /* Шкала глубины. Имена --elevation-*, а не --shadow-*, потому что в
     утилиты Tailwind (shadow-sm/md/lg/card-hover) они попадают через
     @theme inline в app/globals.css — одноимённые переменные дали бы
     там самоссылку. Значения одни на весь проект: ни один компонент
     не пишет box-shadow напрямую.

     Базовые значения — намеренно почти невидимые: Эконом плоский, и
     даже явно выбранный Card variant="elevated" не должен превращать
     его в «карточный» лендинг. Настоящая, читаемая глубина приезжает
     из блока пресета — см. [data-preset="standard"] внизу файла. */
  --elevation-none: none;
  --elevation-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --elevation-md: 0 4px 20px -2px rgb(0 0 0 / 0.06);
  --elevation-lg: 0 10px 30px -4px rgb(0 0 0 / 0.08);
  --elevation-card-hover: 0 12px 32px -4px rgb(0 0 0 / 0.12);

  /* --------------------------------------------------------------------
     РУЧКИ ПРЕСЕТА

     Всё, чем «Стандарт» отличается от «Эконома» визуально, живёт здесь
     и переопределяется одним блоком внизу файла. Значения в :root —
     это Эконом, и они подобраны так, чтобы компоненты, переведённые на
     эти токены, рендерились ровно как до появления пресетов
     (тень none, подъём 0, радиусы документные).

     Правило для будущих правок: новая «дорогая» деталь (тень, подсветка,
     скругление, плашка под иконкой) заводится ТОЛЬКО как токен с
     нейтральным значением в :root и настоящим значением в блоке пресета.
     Хардкод тени/радиуса в компоненте ломает оба тарифа сразу.
     -------------------------------------------------------------------- */

  /* Карточка Card variant="framed" — «карточка по умолчанию»: именно её
     рисуют Features, Gallery, Pricing, Testimonials, Team, Steps.
     В Экономе это hairline-рамка на фоне своей секции без тени,
     в Стандарте — собственная поверхность + тень (см. блок пресета).
     Цвета фона и рамки объявлены не тут, а в [data-surface] ниже:
     var() внутри :root посчитался бы один раз по paper. */
  --card-shadow: var(--elevation-none);
  --card-shadow-hover: var(--elevation-none);
  --card-lift: 0rem; /* сдвиг по Y на hover */
  /* Значения, которыми hoverEffect подменяет пару выше: карточка
     реально кликабельна. В Экономе это единственный источник тени. */
  --card-hover-shadow: var(--elevation-card-hover);
  --card-hover-lift: -0.25rem;
  /* Card variant="elevated" — явная глубина независимо от пресета.
     Hover-значение равно покою: в Экономе поднятая карточка на курсор
     не реагирует, реакцию включает либо пресет, либо hoverEffect. */
  --card-elevated-shadow: var(--elevation-md);
  --card-elevated-shadow-hover: var(--elevation-md);

  /* Выделенный тариф в Pricing (plan.featured). В Экономе подсветка —
     линия --color-fg (акцент занят под кнопку и CTA-блок), в Стандарте
     карточка выходит вперёд рамкой и более сильной тенью. */
  --card-featured-shadow: var(--elevation-none);

  /* Кнопка. В Экономе — плоская заливка без тени и без подъёма. */
  --btn-shadow: var(--elevation-none);
  --btn-shadow-hover: var(--elevation-none);
  --btn-lift: 0rem;

  /* Хедер: в Экономе при скролле появляется линия, а не тень. */
  --header-shadow: var(--elevation-none);
  --header-blur: none;

  /* Плашка под иконкой (Features). В Экономе плашки нет вообще —
     нулевой паддинг и прозрачный фон дают ровно голую иконку. */
  --icon-tile-padding: 0rem;
  --icon-tile-radius: var(--radius-card);

  /* Фоновая подсветка секции и hero. none = чистая заливка (Эконом). */
  --section-tint: none;
  --hero-tint: none;

  /* Поля формы: в Экономе — подчёркивание, а не коробка. */
  --control-bg: transparent;
  --control-border-width: 0 0 var(--border-hairline) 0;
  --control-radius: 0;
  --control-px: 0rem;
  --control-pt: 0.25rem;
  --control-pb: 0.625rem;

  /* Аккордеон FAQ: в Экономе — список на линейках, без зазора и фона. */
  --accordion-gap: 0rem;
  --accordion-radius: 0;
  --accordion-shadow: var(--elevation-none);
  --accordion-px: 0rem;

  /* Фото и карта: тень под медиа. */
  --media-shadow: var(--elevation-none);

  /* Всплывающие панели: тост и меню селекта. */
  --popover-radius: var(--radius-md);
  --popover-shadow: var(--elevation-none);

  /* --------------------------------------------------------------------
     ДВИЖЕНИЕ
     -------------------------------------------------------------------- */
  --duration-reveal: 500ms;
  --duration-ui: 180ms;
  --duration-toast-enter: 300ms;
  --duration-toast-exit: 280ms;
  --ease-reveal: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-ui: cubic-bezier(0.4, 0, 0.2, 1);
  --reveal-shift: 12px;
  --reveal-stagger: 60ms;

  --z-header: 50;
  --z-toast: 80;
}

/* ============================================================================
   ТЁМНАЯ ТЕМА
   На этом проекте выключена (theme.darkModeToggle: false, defaultMode: light).
   Блок остаётся рабочим, чтобы шаблон переносился на другие проекты флагом.
   Палитра остаётся ТЁПЛОЙ — уход в сине-серый убивает характер.
   ========================================================================= */
[data-theme="dark"] {
  color-scheme: dark;

  --palette-paper: #131512;
  --palette-surface: #1b1e1a;
  --palette-ink: #edeae3;
  --palette-ink-muted: #9da096;
  --palette-rule: #2c302b;
  --palette-accent: #5ba47d; /* исходный #14452F на тёмном проваливается */
  --palette-accent-hover: #6db78e;
  --palette-accent-active: #4a8f69;
  --palette-rule-strong: #575b52;

  --palette-ink-fg: #131512;
  --palette-ink-fg-muted: #575b52;
  --palette-ink-rule: #3a3f38;

  --accent-fg: #0f1a14;

  /* Те же тени на тёмном фоне не видно вообще: чёрный с альфой 0.05
     по тёмной бумаге не даёт разницы. Поднимаем непрозрачность —
     форма и радиусы теней остаются те же. */
  --elevation-sm: 0 1px 2px 0 rgb(0 0 0 / 0.4);
  --elevation-md: 0 4px 20px -2px rgb(0 0 0 / 0.45);
  --elevation-lg: 0 10px 30px -4px rgb(0 0 0 / 0.5);
  --elevation-card-hover: 0 12px 32px -4px rgb(0 0 0 / 0.6);
}

/* ============================================================================
   КОНТЕКСТЫ ПОВЕРХНОСТЕЙ
   Секция объявляет data-surface — вложенные компоненты подхватывают
   семантические переменные и не содержат ни одного условия про тему.
   ========================================================================= */

/* Токены, которые ОБЯЗАНЫ пересчитываться на каждой поверхности: их
   значение — var() от --surface-*, а внутри :root такой var()
   подставился бы один раз по paper и дальше только наследовался (та же
   причина, по которой --surface-card объявлен в каждом блоке ниже).
   Селектор без значения ([data-surface], а не четыре штуки с "=") —
   специально: правило одно, а var() внутри резолвится уже на конкретной
   секции, с её собственными --surface-*. */
[data-surface] {
  --card-bg: var(--surface-bg);
  --card-border: var(--surface-rule);
  --card-elevated-bg: var(--surface-card);
  --card-elevated-border: color-mix(
    in srgb,
    var(--surface-rule) 50%,
    transparent
  );
  --card-featured-border: var(--surface-fg);
  --icon-tile-bg: transparent;
  --icon-tile-fg: var(--surface-fg-muted);
  --control-border-color: var(--surface-rule-strong);
  --accordion-bg: transparent;
  --accordion-border: var(--surface-rule);
  --accordion-top-border: var(--surface-rule);
  --header-bg: var(--surface-bg);
}

[data-surface="paper"] {
  --surface-bg: var(--palette-paper);
  --surface-fg: var(--palette-ink);
  --surface-fg-muted: var(--palette-ink-muted);
  --surface-rule: var(--palette-rule);
  --surface-rule-strong: var(--palette-rule-strong);
  /* Единственная поверхность, где карточка по умолчанию всё-таки
     отличается от фона: белый лист поверх тёплой бумаги — это уже есть
     в базовой палитре, отдельной «глубины» для этого не нужно. */
  --surface-card: var(--palette-surface);
}

[data-surface="surface"] {
  --surface-bg: var(--palette-surface);
  --surface-fg: var(--palette-ink);
  --surface-fg-muted: var(--palette-ink-muted);
  --surface-rule: var(--palette-rule);
  --surface-rule-strong: var(--palette-rule-strong);
  /* Лист на листе — карточку отделяет тень/рамка, а не цвет */
  --surface-card: var(--palette-surface);
}

/* Единственная инверсия в теле страницы — блок кейсов. Акцент здесь не живёт. */
[data-surface="ink"] {
  --surface-bg: var(--palette-ink);
  --surface-fg: var(--palette-ink-fg);
  --surface-fg-muted: var(--palette-ink-fg-muted);
  --surface-rule: var(--palette-ink-rule);
  --surface-rule-strong: var(--palette-ink-fg-muted);
  /* На тёмном тень не работает как подъём — карточку приподнимает
     сам тон: на несколько процентов светлее фона блока. */
  --surface-card: color-mix(in srgb, var(--palette-ink) 93%, var(--palette-ink-fg));
  /* Обычный hairline на графите почти не виден, а карточка в реестре
     кейсов должна читаться как объект. Раньше это чинил класс
     border-rule-strong прямо в Gallery — теперь это токен, и им может
     распорядиться пресет. */
  --card-border: var(--surface-rule-strong);
  /* Хвойный акцент на графите тонет ровно так же, как focus-ring
     (см. ниже) — акцентная рамка на тёмном блоке светлеет. */
  --accent-border: var(--palette-ink-fg-muted);
  --badge-soft-bg: color-mix(in srgb, var(--palette-ink-fg) 12%, transparent);
  --badge-soft-fg: var(--palette-ink-fg);
}

/* Единственная акцентная заливка на странице — CTA. */
[data-surface="accent"] {
  --surface-bg: var(--accent);
  --surface-fg: var(--accent-fg);
  --surface-fg-muted: color-mix(in srgb, var(--accent-fg) 72%, transparent);
  --surface-rule: color-mix(in srgb, var(--accent-fg) 24%, transparent);
  --surface-rule-strong: color-mix(in srgb, var(--accent-fg) 45%, transparent);
  --surface-card: color-mix(in srgb, var(--accent) 92%, var(--accent-fg));
  /* Акцентная рамка на акцентной заливке не читается — здесь ею
     работает светлый текстовый цвет блока. */
  --accent-border: var(--surface-rule-strong);
  --badge-soft-bg: color-mix(in srgb, var(--accent-fg) 16%, transparent);
  --badge-soft-fg: var(--accent-fg);

  /* Акцент на акценте не читается — кнопка внутри CTA инвертируется */
  --btn-primary-bg: var(--accent-fg);
  --btn-primary-fg: var(--accent);
  --btn-primary-bg-hover: color-mix(in srgb, var(--accent-fg) 88%, #000);
  --btn-primary-bg-active: color-mix(in srgb, var(--accent-fg) 78%, #000);
}

/* Тёмный блок: focus-ring осветляется, иначе хвойный тонет в графите */
[data-surface="ink"] {
  --accent-ring: var(--palette-ink-fg);
}

/* ============================================================================
   ПРЕСЕТЫ ТАРИФОВ

   data-preset ставится на <html> из content/site.config.ts
   (theme.preset → app/layout.tsx). Отсутствие атрибута = "econom":
   все значения выше уже экономовские, отдельного блока для него нет
   и быть не должно — иначе появится два источника правды.

   Что здесь можно менять: только ручки из блока «РУЧКИ ПРЕСЕТА» выше
   плюс --surface-card и --radius-*. Что НЕЛЬЗЯ: палитру ядра
   (--palette-*), типографическую шкалу и ритм — тариф отличается
   глубиной и пластикой, а не другим брендом и не другими отступами.
   ========================================================================= */

/* ----------------------------------------------------------------------------
   СТАНДАРТ — «дорогой» тариф: собственная поверхность у карточек,
   читаемая многослойная тень, крупные скругления, подсветка секций,
   плашки под иконками, живой hover. Ни одного нового компонента —
   только значения.
   -------------------------------------------------------------------------- */
[data-preset="standard"] {
  /* Пластика: карточка мягкая, кнопка/поле — заметно скруглённые,
     но не «таблетка»; бейдж — таблетка. */
  --radius-card: var(--radius-xl); /* 16px */
  --radius-control: var(--radius-lg); /* 12px */
  --radius-media: var(--radius-xl); /* 16px */
  --radius-pill: var(--radius-full);

  /* Глубина. Две тени в каждой ступени — контактная (короткая, плотная)
     и рассеянная (длинная, мягкая): одна плоская тень на 6% альфы, как
     в базе, физически не читается на бумаге и была главной причиной
     того, что «Стандарт» выглядел как «Эконом».
     Цвет — тёплый чёрный (24 22 18), а не чистый: на тёплой бумаге
     нейтрально-серая тень выглядит грязной. */
  --elevation-sm:
    0 1px 2px -1px rgb(24 22 18 / 0.1), 0 1px 3px 0 rgb(24 22 18 / 0.08);
  --elevation-md:
    0 2px 6px -2px rgb(24 22 18 / 0.1), 0 12px 28px -8px rgb(24 22 18 / 0.16);
  --elevation-lg:
    0 4px 10px -3px rgb(24 22 18 / 0.1), 0 24px 48px -14px rgb(24 22 18 / 0.22);
  --elevation-card-hover:
    0 6px 14px -4px rgb(24 22 18 / 0.12), 0 32px 64px -18px rgb(24 22 18 / 0.28);

  /* Карточка по умолчанию (framed) перестаёт быть плоской рамкой. */
  --card-shadow: var(--elevation-md);
  --card-shadow-hover: var(--elevation-lg);
  --card-lift: -0.125rem; /* лёгкий подъём даже у некликабельной карточки */
  --card-hover-shadow: var(--elevation-card-hover);
  --card-hover-lift: -0.375rem;
  --card-elevated-shadow: var(--elevation-lg);
  --card-elevated-shadow-hover: var(--elevation-card-hover);
  --card-featured-shadow: var(--elevation-card-hover);

  /* Кнопка получает вес: тень покоя + подъём под курсором. */
  --btn-shadow: var(--elevation-sm);
  --btn-shadow-hover: var(--elevation-md);
  --btn-lift: -0.0625rem;

  /* Хедер отрывается от страницы при скролле. */
  --header-shadow: var(--elevation-sm);
  --header-blur: saturate(1.6) blur(12px);

  /* Иконка садится в акцентную плашку — самый заметный признак того,
     что это не «таблица услуг», а продуктовые карточки. */
  --icon-tile-padding: 0.875rem;

  /* Медиа: фото живут карточками, а не вклейками. */
  --media-shadow: var(--elevation-md);

  /* Всплывающие панели отрываются от страницы. */
  --popover-radius: var(--radius-card);
  --popover-shadow: var(--elevation-lg);

  /* Поля формы становятся коробками. */
  --control-bg: var(--surface-card);
  --control-border-width: var(--border-hairline);
  --control-radius: var(--radius-control);
  --control-px: 0.875rem;
  --control-pt: 0.75rem;
  --control-pb: 0.75rem;

  /* FAQ: список на линейках → стопка карточек. */
  --accordion-gap: 0.75rem;
  --accordion-radius: var(--radius-card);
  --accordion-shadow: var(--elevation-sm);
  --accordion-px: 1.5rem;
}

/* Карточка получает собственную поверхность на любой секции.
   Отдельным правилом по [data-surface], а не внутри блока выше:
   var(--surface-card) обязан резолвиться на самой секции. */
[data-preset="standard"] [data-surface],
[data-preset="premium"] [data-surface] {
  --card-bg: var(--surface-card);
  --card-border: color-mix(in srgb, var(--surface-rule) 70%, transparent);
  /* Выделенный тариф выходит вперёд акцентной рамкой: в дорогом тарифе
     это единственное место, где акцент допускается на рамке карточки. */
  --card-featured-border: var(--accent-border);
}

/* Плашка под иконкой берёт уже готовую, посчитанную под каждую
   поверхность пару из Badge variant="soft" — на тёмном и акцентном
   блоке хвойный акцент не читается, а эта пара там уже переопределена. */
[data-preset="standard"] [data-surface] {
  --icon-tile-bg: var(--badge-soft-bg);
  --icon-tile-fg: var(--badge-soft-fg);

  /* Аккордеон превращается в стопку карточек: разделительные линейки
     снимаются (их роль берут зазор и подложка), фон — поверхность
     карточки своей секции. */
  --accordion-bg: var(--surface-card);
  --accordion-border: transparent;
  --accordion-top-border: transparent;

  /* Полупрозрачный хедер поверх подсвеченной страницы — вместе с
     --header-blur даёт «стекло». Без backdrop-filter (старый браузер)
     останется просто чуть прозрачная плашка, читаемость не страдает. */
  --header-bg: color-mix(in srgb, var(--surface-bg) 82%, transparent);
}

/* Подсветка секций. Не «градиентный фон» ради градиента: очень слабый
   акцентный намёк сверху даёт странице глубину и не спорит с правилом
   акцента — он ниже порога, на котором читается как цвет. */
[data-preset="standard"] [data-surface="paper"],
[data-preset="standard"] [data-surface="surface"] {
  --section-tint: radial-gradient(
    120% 80% at 50% 0%,
    color-mix(in srgb, var(--accent) 6%, transparent) 0%,
    transparent 62%
  );
  --hero-tint:
    radial-gradient(
      68% 62% at 88% 12%,
      color-mix(in srgb, var(--accent) 15%, transparent) 0%,
      transparent 70%
    ),
    linear-gradient(
      180deg,
      color-mix(in srgb, var(--accent) 6%, transparent) 0%,
      transparent 58%
    );
}

[data-preset="standard"] [data-surface="ink"] {
  --section-tint: radial-gradient(
    110% 70% at 50% 0%,
    color-mix(in srgb, var(--palette-ink-fg) 7%, transparent) 0%,
    transparent 68%
  );
}

[data-preset="standard"] [data-surface="accent"] {
  --section-tint: radial-gradient(
    90% 130% at 100% 0%,
    color-mix(in srgb, var(--accent-fg) 16%, transparent) 0%,
    transparent 62%
  );
}

/* Тёмная тема + Стандарт: форма теней та же, альфа выше — иначе на
   тёмной бумаге подъёма не видно вообще. Селектор двойной, чтобы
   выиграть у одиночного [data-preset="standard"] выше (обе группы
   висят на <html>, специфичность решает). */
[data-theme="dark"][data-preset="standard"] {
  --elevation-sm:
    0 1px 2px -1px rgb(0 0 0 / 0.5), 0 1px 3px 0 rgb(0 0 0 / 0.4);
  --elevation-md:
    0 2px 6px -2px rgb(0 0 0 / 0.5), 0 12px 28px -8px rgb(0 0 0 / 0.55);
  --elevation-lg:
    0 4px 10px -3px rgb(0 0 0 / 0.5), 0 24px 48px -14px rgb(0 0 0 / 0.6);
  --elevation-card-hover:
    0 6px 14px -4px rgb(0 0 0 / 0.55), 0 32px 64px -18px rgb(0 0 0 / 0.7);
}

/* ----------------------------------------------------------------------------
   PREMIUM — тоже «дорогой», но противоположным способом: глубина
   строится рамкой и воздухом, а не тенью. Радиус минимальный,
   теней нет вообще, карточка стоит на своей поверхности с акцентной
   рамкой. Пластика кнопок и полей остаётся документной.
   -------------------------------------------------------------------------- */
[data-preset="premium"] {
  --radius-card: var(--radius-sm);
  --radius-control: var(--radius-sm);
  --radius-media: var(--radius-sm);
  --radius-pill: var(--radius-sm);

  --card-shadow: var(--elevation-none);
  --card-shadow-hover: var(--elevation-none);
  --card-lift: 0rem;
  --card-elevated-shadow: var(--elevation-none);
  --card-elevated-shadow-hover: var(--elevation-none);

  /* Единственное «движение» премиума — рамка, а не подъём. */
  --card-hover-shadow: var(--elevation-none);
  --card-hover-lift: 0rem;
}

/* Рамка карточки — акцентная и приглушённая: в полную силу акцента
   она кричит на каждой карточке сразу. */
[data-preset="premium"] [data-surface] {
  --card-border: color-mix(in srgb, var(--accent-border) 45%, transparent);
}
</file>

