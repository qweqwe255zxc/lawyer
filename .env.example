# Скопировать в .env.local и заполнить. Пустые значения — не ошибка:
# форма продолжит работать и просто напечатает заявку в лог сервера.

# --- Telegram -----------------------------------------------------------
# Токен у @BotFather, chat_id — у @userinfobot (для группы id отрицательный)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (Resend, HTTP API — без SMTP и без лишних зависимостей) -------
# Ключ: https://resend.com/api-keys. Домен MAIL_FROM должен быть верифицирован.
RESEND_API_KEY=
MAIL_FROM="Сайт бюро <noreply@example.ru>"
MAIL_TO=info@example.ru
# Необязательно: адрес для «Ответить»
MAIL_REPLY_TO=
